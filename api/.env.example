# Application mode: local, development, test, central, server, staging, production
APP_ENV=local
DEBUG=False
SECRET_KEY=change-me-before-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Canonical database contract
# SQLite is allowed only for local/development/test.
# Central/server/staging/production requires PostgreSQL and all DB_* values.
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# File storage
ARCHIVE_STORAGE_ROOT=media
MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=100

# Authentication
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Application metadata
APP_NAME=Archive Management API
APP_VERSION=1.0.0

# Transitional aliases accepted by settings.py:
# DATABASE_ENGINE -> DB_ENGINE
# DATABASE_NAME / POSTGRES_DB -> DB_NAME
# DATABASE_USER / POSTGRES_USER -> DB_USER
# DATABASE_PASSWORD / POSTGRES_PASSWORD -> DB_PASSWORD
# DATABASE_HOST / POSTGRES_HOST -> DB_HOST
# DATABASE_PORT / POSTGRES_PORT -> DB_PORT
# DJANGO_DEBUG -> DEBUG
# DJANGO_SECRET_KEY -> SECRET_KEY
# DJANGO_ALLOWED_HOSTS -> ALLOWED_HOSTS
# MEDIA_ROOT -> ARCHIVE_STORAGE_ROOT
# DATABASE_URL is intentionally not consumed.
