import type { ID } from "@/types/common";

export type OcrJobStatus =
  | "PENDING"
  | "RUNNING"
  | "SUCCESS"
  | "FAILED"
  | "pending"
  | "running"
  | "success"
  | "failed"
  | string;

export interface OcrJob {
  id: ID;
  digital_file?: ID;
  digital_file_id?: ID;
  status?: OcrJobStatus;
  message?: string;
  error_message?: string;
  created_at?: string;
  updated_at?: string;
  started_at?: string | null;
  finished_at?: string | null;
}

export interface OcrRunResult {
  job?: OcrJob;
  id?: ID;
  digital_file?: ID;
  digital_file_id?: ID;
  status?: OcrJobStatus;
  message?: string;
  error_message?: string;
}

export interface OcrTextResult {
  digital_file?: ID;
  digital_file_id?: ID;
  text?: string;
  ocr_text?: string;
  content?: string;
  extracted_text?: string;
  status?: OcrJobStatus;
  message?: string;
  error_message?: string;
}

export interface OcrSearchResultItem {
  id?: ID;

  digital_file?: ID;
  digital_file_id?: ID;
  digital_file_name?: string;
  original_name?: string;

  profile?: ID;
  profile_id?: ID;
  profile_code?: string;
  profile_title?: string;

  document?: ID;
  document_id?: ID;
  document_code?: string;
  document_title?: string;

  snippet?: string;
  text?: string;
  content?: string;
  rank?: number;
}

export interface OcrSearchResult {
  query?: string;
  count?: number;
  results?: OcrSearchResultItem[];
}